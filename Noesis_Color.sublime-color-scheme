// DOCUMENTATION
// V2.0 
//
// Color scheme in dark mode intended for highly productive programming.
// Theme: Power, control, highly advanced tech, and godliness.
//
// ARCHITECTURE:
// 1. Base Palette: Raw hex values defining the absolute colors.
// 2. Semantic Mappings: Functional assignments (e.g., 'syntax_keyword' = 'base_purple').
// 3. Globals & Rules: UI and syntax scopes consuming only Semantic variables.
//
// END DOCUMENTATION
{
  // --- Metadata ---
  "name": "Noesis Color Theme",
  "author": "Mr. Hoorn",
  "version": "2.0.0",
  // --- Variables ---
  "variables": {
    // ==========================================
    // 1. BASE PALETTE (Raw Colors)
    // ==========================================
    // The Void (Backgrounds - deep abyssal cool-darks)
    "base_bg_0": "#0B0E14", // Absolute darkest, main background
    "base_bg_1": "#111520", // Slightly elevated, gutters
    "base_bg_2": "#1A2030", // Selection areas
    "base_bg_3": "#232A3F", // Highlights/Active lines
    // The Noise (Neutrals - for structural UI)
    "base_neutral_dim": "#465173", // Barely visible (Docs, hidden characters)
    "base_neutral_mid": "#6B7A99", // UI borders, line numbers
    "base_neutral_bright": "#A1B0D1", // Secondary UI elements
    // The Data (Foregrounds)
    "base_fg_main": "#D4DCE8", // Standard variables
    "base_white": "#FFFFFF", // High emphasis
    // The Power (Hues - high luminosity for dark mode)
    "base_cyan": "#00E5FF", // Tech, Types, Classes
    "base_mint": "#00FFAA", // Built-in primitives, foundational architecture
    "base_plasma": "#39FF14", // Functions, Execution
    "base_purple": "#B5179E", // Control flow, Keywords
    "base_magenta": "#D500FF", // Truth evaluation, Logic gates
    "base_pink": "#FF007F", // State Mutation, Math
    "base_yellow": "#FCEEA7", // Strings, Payload data
    "base_sapphire": "#0077FF",
    "base_cyan_muted": "#0088AA",
    "base_orange": "#FF5500", // Constants, Primitives, Immutable data
    // Status & Alerts
    "base_alert": "#FF9F1C", // Critical/Comments (Piercing Amber)
    "base_error": "#FF003C", // Illegal, Deletions
    "base_success": "#00FA9A", // Additions
    // ==========================================
    // 2. SEMANTIC MAPPINGS (Functional Usage)
    // ==========================================
    // Environment & UI
    "env_bg": "var(base_bg_0)",
    "env_gutter": "var(base_bg_1)",
    "env_selection": "var(base_bg_2)",
    "env_highlight": "var(base_bg_3)",
    "env_border": "var(base_neutral_dim)",
    "env_rulers": "var(base_neutral_dim)",
    "env_caret": "var(base_cyan)",
    "env_line_nums": "var(base_neutral_mid)",
    // Core Syntax
    "syntax_default": "var(base_fg_main)",
    "syntax_keyword": "var(base_purple)",
    "syntax_entity": "var(base_cyan)",
    "syntax_function": "var(base_plasma)",
    "syntax_variable": "var(base_fg_main)",
    "syntax_string": "var(base_yellow)",
    "syntax_operator_math": "var(base_pink)",
    "syntax_operator_logic": "var(base_magenta)",
    "syntax_punctuation": "var(base_neutral_mid)",
    "syntax_mapping_keys": "var(base_sapphire)",
    "syntax_reference": "var(base_cyan_muted)",
    "syntax_constant": "var(base_orange)",
    "syntax_attribute": "var(base_neutral_bright)",
    "syntax_selector": "var(base_cyan_muted)",
    "syntax_declaration": "var(base_cyan)",
    "syntax_namespace": "var(base_neutral_bright)",
    "syntax_primitive_type": "var(base_mint)",
    "syntax_modifier": "var(base_neutral_bright)",
    "syntax_module_ref": "var(base_neutral_bright)",
    "syntax_property": "var(base_fg_main)",
    "syntax_block_bg": "var(base_bg_1)",
    // Specific Philosophy Mappings
    "syntax_doc": "var(base_neutral_dim)",
    "syntax_comment": "var(base_alert)",
    // Git & Status
    "git_added": "var(base_success)",
    "git_modified": "var(base_alert)",
    "git_deleted": "var(base_error)",
    "git_ignored": "var(base_neutral_dim)", // Deeply suppressed noise
    "git_untracked": "var(base_neutral_mid)", // Visible, but uncommitted
    // Annotations (Inline Blame / HUD Badges)
    "git_annotation_fg": "var(base_neutral_mid)",
    "git_annotation_bg": "var(base_bg_1)", // Slight elevation from absolute void
    // Fallbacks
    "status_error": "var(base_error)",
    "status_missed": "var(base_pink)"
  },
  // --- Globals ---
  "globals": {
    "background": "var(env_bg)",
    "foreground": "var(syntax_default)",
    "caret": "var(env_caret)",
    "rulers": "var(env_rulers)",
    "guide": "var(env_rulers)",
    "active_guide": "var(base_neutral_mid)",
    "stack_guide": "var(env_rulers)",
    // Selection
    "selection": "var(env_selection)",
    "selection_border": "var(base_neutral_bright)",
    "selection_border_width": "2",
    // Minimap
    "minimap_border": "var(base_neutral_bright)",
    // Gutter
    "line_highlight": "var(env_highlight)",
    "gutter": "var(env_gutter)",
    "gutter_foreground": "var(env_line_nums)",
    "gutter_foreground_highlight": "var(base_white)",
    // Git
    "line_diff_added": "var(git_added)",
    "line_diff_modified": "var(git_modified)",
    "line_diff_deleted": "var(git_deleted)",
    // CSS Inserts (Surgical UI Overrides)
    "popup_css": "html, body { background-color: #0B0E14; color: #D4DCE8; }",
    "phantom_css": "#gitgutter-line-annotation { background-color: #111520; } html, body { background-color: #0B0E14 !important; color: #D4DCE8; } span.nums { color: #00E5FF; } span.context { color: #6B7A99; } div.scope { color: #6B7A99; }"
  },
  // --- Rules ---
  "rules": [
    // ==========================================
    // TIER 1: CORE LOGIC & ARCHITECTURE
    // ==========================================
    {
      "name": "Control Flow (The Brain)",
      "scope": "keyword.control, keyword.other - (keyword.declaration | storage.type | storage.modifier), keyword.gomod",
      "font_style": "italic",
      "foreground": "var(syntax_keyword)"
    },
    {
      "name": "Engine Directives (Compile-Time State)",
      "scope": "variable.language.compiler, punctuation.definition.variable.compiler, variable.language.compiler.directive",
      "font_style": "italic bold underline",
      "foreground": "var(syntax_keyword)",
      "background": "var(syntax_block_bg)",
    },
    {
      "name": "Logical & Comparison Operators (The Gates)",
      "scope": "keyword.operator.logical, keyword.operator.comparison, keyword.operator.relational",
      "font_style": "bold",
      "foreground": "var(syntax_operator_logic)"
    },
    {
      "name": "Math & Assignment Operators (The Mutations)",
      "scope": "keyword.operator.assignment, keyword.operator.arithmetic, keyword.operator.math, keyword.operator.increment, keyword.operator.decrement",
      "font_style": "bold",
      "foreground": "var(syntax_operator_math)"
    },
    {
      "name": "Fallback Operators",
      "scope": "keyword.operator",
      "font_style": "bold",
      "foreground": "var(syntax_operator_math)"
    },
    {
      "name": "Architecture Declarations (The Blueprints)",
      "scope": "keyword.other.version, keyword.declaration.module, storage.type.function, keyword.declaration.function, storage.type.class, keyword.declaration.class, storage.type.struct, keyword.declaration.struct, storage.type.enum, keyword.declaration.enum, storage.type.interface, keyword.declaration.interface, storage.type.type, keyword.declaration.type, storage.type.namespace, keyword.declaration.namespace, keyword.declaration.map",
      "font_style": "italic",
      "foreground": "var(syntax_keyword)"
    },
    {
      "name": "Inheritance & Relational Modifiers",
      "scope": "storage.modifier.extends, storage.modifier.implements, keyword.declaration.implements, keyword.declaration.extends",
      "font_style": "italic",
      "foreground": "var(syntax_modifier)"
    },
    {
      "name": "Event Hooks (onShow, onHide)",
      "scope": "keyword.control.event",
      "font_style": "bold",
      "foreground": "var(syntax_keyword)"
    },
    {
      "name": "State Declarations (Memory Allocation)",
      "scope": "keyword.declaration.var, keyword.declaration.const, storage.type.variable, storage.type.constant",
      "font_style": "italic",
      "foreground": "var(syntax_keyword)"
    },
    {
      "name": "Data Modifiers (The Traits)",
      "scope": "storage.modifier, storage.type.modifier",
      "font_style": "italic",
      "foreground": "var(syntax_modifier)"
    },
    {
      "name": "User-Defined Types, Classes, and Modules",
      "scope": "entity.name.type, entity.name.class, entity.name.module, support.class, storage.type, variable.parameter.type, variable.other.type",
      "font_style": "bold",
      "foreground": "var(syntax_entity)"
    },
    {
      "name": "Inherited Classes & Interfaces (Pointers)",
      "scope": "entity.other.inherited-class",
      "font_style": "italic",
      "foreground": "var(syntax_reference)"
    },
    {
      "name": "Namespaces",
      "scope": "entity.name.namespace",
      "foreground": "var(syntax_namespace)"
    },
    {
      "name": "Functions (The Actions)",
      "scope": "entity.name.function, support.function, variable.function",
      "font_style": "bold",
      "foreground": "var(syntax_function)"
    },
    {
      "name": "Module and Package References",
      "scope": "support.other.module",
      "font_style": "italic",
      "foreground": "var(syntax_module_ref)"
    },
    // ==========================================
    // TIER 2: DATA & STATE
    // ==========================================
    {
      "name": "Built-In Primitive Types (The Raw Material)",
      "scope": "support.type, support.type.builtin, support.type.primitive",
      "font_style": "italic",
      "foreground": "var(syntax_primitive_type)"
    },
    {
      "name": "Variable Declaration (The Birth of State)",
      "scope": "entity.name.variable, meta.definition.variable, variable.other.readwrite.declaration, variable.other.declaration, variable.other.assignment",
      "font_style": "bold",
      "foreground": "var(syntax_variable)"
    },
    {
      "name": "Variable Parameters (Injected State)",
      "scope": "variable.parameter",
      "font_style": "italic",
      "foreground": "var(syntax_variable)"
    },
    {
      "name": "Variable Reference (Pointers)",
      "scope": "variable.other, support.class.color-set",
      "font_style": "italic",
      "foreground": "var(syntax_reference)"
    },
    {
      "name": "Properties and Members (Object State)",
      "scope": "variable.other.member, variable.other.property, meta.property.object",
      "foreground": "var(syntax_property)",
      "font_style": "",
    },
    {
      "name": "Built-In Language Schema Keys (DSL Properties)",
      "scope": "support.type.property-name",
      "font_style": "",
      "foreground": "var(syntax_attribute)"
    },
    {
      "name": "Strings",
      "scope": "(string) - (meta.mapping.key)",
      "foreground": "var(syntax_string)"
    },
    {
      "name": "Constants, Colors, and Numbers",
      "scope": "constant, support.constant, constant.numeric, variable.gomod",
      "font_style": "bold",
      "foreground": "var(syntax_constant)"
    },
    {
      "name": "Constant Properties (Object State Lookups)",
      "scope": "variable.other.constant.property, variable.other.constant",
      "font_style": "italic bold",
      "foreground": "var(syntax_property)"
    },
    {
      "name": "Built-In Constants & Enums",
      "scope": "constant.language, support.constant.font-style",
      "font_style": "bold underline",
      "foreground": "var(syntax_constant)"
    },
    // ==========================================
    // TIER 3: STRUCTURAL NOISE
    // ==========================================
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "var(syntax_punctuation)"
    },
    {
      "name": "Documentation (Dim)",
      "scope": "comment.block, string.quoted.docstring",
      "font_style": "italic",
      "foreground": "var(syntax_doc)"
    },
    {
      "name": "Comments (Alert/Critical)",
      "scope": "comment.line",
      "font_style": "bold",
      "foreground": "var(syntax_comment)"
    },
    // ==========================================
    // TIER 4: SPECIFIC LANGUAGE OVERRIDES
    // ==========================================
    {
      "name": "JSON/Dict Keys and Schema Keywords",
      "scope": "meta.mapping.key, source.json.sublime.color-scheme keyword.other, keyword.other.rule.sublime-color-scheme, keyword.other.main.sublime-color-scheme, keyword.other.variables.sublime-color-scheme",
      "foreground": "var(syntax_mapping_keys)",
      "font_style": ""
    },
    {
      "name": "JSON/Dict Value",
      "scope": "meta.mapping.value",
      "foreground": "var(syntax_variable)"
    },
    {
      "name": "HTML/XML Tags",
      "scope": "entity.name.tag",
      "font_style": "bold",
      "foreground": "var(syntax_entity)"
    },
    {
      "name": "HTML Attributes & CSS Classes/IDs",
      "scope": "entity.other.attribute-name",
      "foreground": "var(syntax_attribute)"
    },
    {
      "name": "Properties, Attributes, and Schema Keys",
      "scope": "meta.property.name, entity.other.attribute-name",
      "foreground": "var(syntax_attribute)"
    },
    {
      "name": "Sublime Syntax: Scope Declarations (Overrides storage.type)",
      "scope": "storage.type.scope-name, storage.modifier.meta-scope, storage.type.meta-scope, storage.type.display-name, storage.type.version, source.yaml.sublime.syntax entity.name.tag",
      "font_style": "",
      "foreground": "var(syntax_attribute)"
    },
    {
      "name": "Scope Selectors (Overrides Strings)",
      "scope": "string.unquoted.scope-segment, meta.scope.sublime-syntax string",
      "font_style": "italic",
      "foreground": "var(syntax_selector)"
    },
    {
      "name": "Regular Expressions (Literal Base)",
      "scope": "string.regexp, meta.literal.regexp",
      "foreground": "var(syntax_string)"
    },
    {
      "name": "Regular Expressions: Escapes (Primitives)",
      "scope": "constant.character.escape",
      "font_style": "bold",
      "foreground": "var(syntax_constant)"
    },
    {
      "name": "Regular Expressions: Assertions (Logic Gates)",
      "scope": "constant.other.assertion",
      "font_style": "bold",
      "foreground": "var(syntax_operator_logic)"
    },
    {
      "name": "Go: Struct Tags / Annotations",
      "scope": "variable.annotation, meta.annotation.identifier, meta.annotation",
      "font_style": "italic",
      "foreground": "var(syntax_attribute)"
    },
    // ==========================================
    // LANGSPEC: CORE ENGINE & BLOCKS
    // ==========================================
    {
      "name": "LangSpec: Elevated Block Backgrounds",
      "scope": "meta.header.body.lspec, meta.meta-section.body.lspec",
      "background": "var(syntax_block_bg)"
    },
    {
      "name": "LangSpec: Language Identity (The God Entity)",
      "scope": "entity.name.language.lspec",
      "font_style": "bold",
      "foreground": "var(syntax_entity)"
    },
    {
      "name": "LangSpec: Section Declarations (The Blueprints)",
      "scope": "keyword.pragma.lspec, keyword.tool.lspec, keyword.lspec.lspec, keyword.declaration.pattern.lspec, keyword.declaration.lex.lspec, keyword.declaration.parse.lspec, keyword.declaration.pratt.lspec, keyword.declaration.ignore.lspec",
      "font_style": "bold italic",
      "foreground": "var(syntax_declaration)"
    },
    {
      "name": "LangSpec: Parse Rules (Function Declarations)",
      "scope": "entity.name.function.parser-expression.lspec, entity.name.function.parser-rule.lspec",
      "font_style": "bold",
      "foreground": "var(syntax_function)"
    },
    {
      "name": "LangSpec: User-Defined Tokens & Roles (The Birth)",
      "scope": "entity.name.pattern.constant.lspec, entity.name.token.lspec, entity.name.token-role.lspec, entity.name.type.parser-node.lspec",
      "font_style": "bold",
      "foreground": "var(syntax_entity)"
    },
    {
      "name": "LangSpec: References & Calls (The Life/Pointers)",
      "scope": "constant.language.pattern-reference.lspec, constant.language.token-reference.lspec, constant.language.symbol-reference.lspec, constant.language.token-role-reference.lspec, entity.name.function.expression-reference.lspec",
      "font_style": "italic",
      "foreground": "var(syntax_reference)"
    },
    {
      "name": "LangSpec: Expression References",
      "scope": "entity.name.function.expression-reference.lspec",
      "font_style": "italic underline",
    },
    {
      "name": "LangSpec: AST Modifiers (The Traits)",
      "scope": "keyword.operator.transparent.lspec, keyword.operator.virtual.lspec, keyword.operator.implicit.lspec",
      "font_style": "italic",
      "foreground": "var(syntax_modifier)"
    },
    {
      "name": "LangSpec: Parser Control Flow (The Engine)",
      "scope": "keyword.operator.nest.lspec, keyword.operator.sync.lspec, keyword.operator.predict.lspec",
      "font_style": "bold",
      "foreground": "var(syntax_keyword)"
    },
    {
      "name": "LangSpec: Logical OR (The Gates)",
      "scope": "punctuation.pipe.lspec -meta.header, keyword.operator.alternation.lspec",
      "font_style": "bold",
      "foreground": "var(syntax_operator_logic)"
    },
    {
      "name": "LangSpec: Quantifiers (The Mutations)",
      "scope": "keyword.operator.optional.lspec, keyword.operator.star.lspec, keyword.operator.plus.lspec",
      "font_style": "bold",
      "foreground": "var(syntax_operator_math)"
    },
    {
      "name": "LangSpec: Parse Groups (Execution Boundaries)",
      "scope": "meta.parse-group.body.lspec punctuation.section.parens",
      "font_style": "bold",
      "foreground": "var(syntax_operator_logic)"
    },
    // ==========================================
    // RULEFORGE
    // ==========================================
    {
      "name": "Game State Properties (External/Injected)",
      "scope": "variable.other.property.game.rf, variable.other.property.game",
      "font_style": "italic",
      "foreground": "var(syntax_property)"
    },
    // ==========================================
    // GIT GUTTER & TELEMETRY
    // ==========================================
    {
      "name": "GitGutter: Tracking Status",
      "scope": "markup.inserted.git_gutter",
      "foreground": "var(git_added)"
    },
    {
      "name": "GitGutter: Changed",
      "scope": "markup.changed.git_gutter",
      "foreground": "var(git_modified)"
    },
    {
      "name": "GitGutter: Deleted",
      "scope": "markup.deleted.git_gutter",
      "foreground": "var(git_deleted)"
    },
    {
      "name": "GitGutter: Ignored",
      "scope": "markup.ignored.git_gutter",
      "foreground": "var(git_ignored)"
    },
    {
      "name": "GitGutter: Untracked",
      "scope": "markup.untracked.git_gutter",
      "foreground": "var(git_untracked)"
    },
    {
      "name": "GitGutter: Inline Annotation (Blame)",
      "scope": "comment.line.annotation.git_gutter",
      "font_style": "italic",
      "foreground": "var(git_annotation_fg)"
    },
    // ==========================================
    // TIER 5: SYSTEM ALERTS & FALLBACKS
    // ==========================================
    {
      "name": "Fallback",
      "scope": "source",
      "foreground": "var(status_missed)"
    },
    {
      "name": "Illegal",
      "scope": "invalid",
      "font_style": "underline bold",
      "foreground": "var(status_error)"
    }
  ]
}