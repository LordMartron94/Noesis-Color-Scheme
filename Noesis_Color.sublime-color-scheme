// DOCUMENTATION
// V2.0 
//
// Color scheme in dark mode intended for highly productive programming.
// Theme: Power, control, highly advanced tech, and godliness.
//
// ARCHITECTURE:
// 1. Base Palette: Raw hex values defining the absolute colors.
// 2. Semantic Mappings: Functional assignments (e.g., 'syntax_keyword' = 'base_purple').
// 3. Globals & Rules: UI and syntax scopes consuming only Semantic variables.
//
// SYNTAX USAGE GUIDE:
// - syntax_doc: Deeply dimmed. Used for public API documentation that shouldn't distract.
// - syntax_comment: Piercing amber. Used strictly as an alert/warning for complex logic.
// - syntax_keyword: Neon purple. The control flow and bones of the logic.
// - syntax_entity: Electric cyan. Classes, types, and god-level constructs.
// - syntax_function: Plasma green. Executable actions and methods.
// - syntax_variable: Stark white/light silver. The standard data being manipulated.
// - syntax_string: Pale yellow. Literal data payloads.
// - syntax_operator_math: Crimson/Pink. Mathematical and assignment mutations.
// - syntax_operator_logic: Neon Magenta. Truth evaluation and control flow gates.
//
// END DOCUMENTATION
{
  // --- Metadata ---
  "name": "Noesis Color Theme",
  "author": "Mr. Hoorn",
  "version": "2.0.0",
  // --- Variables ---
  "variables": {
    // ==========================================
    // 1. BASE PALETTE (Raw Colors)
    // ==========================================
    // The Void (Backgrounds - deep abyssal cool-darks)
    "base_bg_0": "#0B0E14", // Absolute darkest, main background
    "base_bg_1": "#111520", // Slightly elevated, gutters
    "base_bg_2": "#1A2030", // Selection areas
    "base_bg_3": "#232A3F", // Highlights/Active lines
    // The Noise (Neutrals - for structural UI)
    "base_neutral_dim": "#465173", // Barely visible (Docs, hidden characters)
    "base_neutral_mid": "#6B7A99", // UI borders, line numbers
    "base_neutral_bright": "#A1B0D1", // Secondary UI elements
    // The Data (Foregrounds)
    "base_fg_main": "#D4DCE8", // Standard variables
    "base_white": "#FFFFFF", // High emphasis
    // The Power (Hues - high luminosity for dark mode)
    "base_cyan": "#00E5FF", // Tech, Types, Classes
    "base_plasma": "#39FF14", // Functions, Execution
    "base_purple": "#B5179E", // Control flow, Keywords
    "base_magenta": "#D500FF", // Truth evaluation, Logic gates
    "base_pink": "#FF007F", // State Mutation, Math
    "base_yellow": "#FCEEA7", // Strings, Payload data
    "base_sapphire": "#0077FF",
    "base_cyan_muted": "#0088AA",
    "base_orange": "#FF5500", // Constants, Primitives, Immutable data
    // Status & Alerts
    "base_alert": "#FF9F1C", // Critical/Comments (Piercing Amber)
    "base_error": "#FF003C", // Illegal, Deletions
    "base_success": "#00FA9A", // Additions
    // ==========================================
    // 2. SEMANTIC MAPPINGS (Functional Usage)
    // ==========================================
    // Environment & UI
    "env_bg": "var(base_bg_0)",
    "env_gutter": "var(base_bg_1)",
    "env_selection": "var(base_bg_2)",
    "env_highlight": "var(base_bg_3)",
    "env_border": "var(base_neutral_dim)",
    "env_rulers": "var(base_neutral_dim)",
    "env_caret": "var(base_cyan)",
    "env_line_nums": "var(base_neutral_mid)",
    // Core Syntax
    "syntax_default": "var(base_fg_main)",
    "syntax_keyword": "var(base_purple)",
    "syntax_entity": "var(base_cyan)",
    "syntax_function": "var(base_plasma)",
    "syntax_variable": "var(base_fg_main)",
    "syntax_string": "var(base_yellow)",
    "syntax_operator_math": "var(base_pink)",
    "syntax_operator_logic": "var(base_magenta)",
    "syntax_punctuation": "var(base_neutral_mid)",
    "syntax_mapping_keys": "var(base_sapphire)",
    "syntax_reference": "var(base_cyan_muted)",
    "syntax_constant": "var(base_orange)",
    "syntax_attribute": "var(base_sapphire)",
    "syntax_selector": "var(base_cyan_muted)",
    // Specific Philosophy Mappings
    "syntax_doc": "var(base_neutral_dim)",
    "syntax_comment": "var(base_alert)",
    // Git & Status
    "git_added": "var(base_success)",
    "git_modified": "var(base_alert)",
    "git_deleted": "var(base_error)",
    "git_ignored": "var(base_neutral_dim)", // Deeply suppressed noise
    "git_untracked": "var(base_neutral_mid)", // Visible, but uncommitted
    // Annotations (Inline Blame / HUD Badges)
    "git_annotation_fg": "var(base_neutral_mid)",
    "git_annotation_bg": "var(base_bg_1)", // Slight elevation from absolute void
    // Fallbacks
    "status_error": "var(base_error)",
    "status_missed": "var(base_pink)"
  },
  // --- Globals ---
  "globals": {
    "background": "var(env_bg)",
    "foreground": "var(syntax_default)",
    "caret": "var(env_caret)",
    "rulers": "var(env_rulers)",
    "guide": "var(env_rulers)",
    "active_guide": "var(base_neutral_mid)",
    "stack_guide": "var(env_rulers)",
    // Selection
    "selection": "var(env_selection)",
    "selection_border": "var(base_neutral_bright)",
    "selection_border_width": "2",
    // Gutter
    "line_highlight": "var(env_highlight)",
    "gutter": "var(env_gutter)",
    "gutter_foreground": "var(env_line_nums)",
    "gutter_foreground_highlight": "var(base_white)",
    // Git
    "line_diff_added": "var(git_added)",
    "line_diff_modified": "var(git_modified)",
    "line_diff_deleted": "var(git_deleted)",
    // CSS Inserts (Surgical UI Overrides)
    "popup_css": "html, body { background-color: #0B0E14; color: #D4DCE8; }",
    "phantom_css": "#gitgutter-line-annotation { background-color: #111520; } html, body { background-color: #0B0E14 !important; color: #D4DCE8; } span.nums { color: #00E5FF; } span.context { color: #6B7A99; } div.scope { color: #6B7A99; }"
  },
  // --- Rules ---
  "rules": [
    // ==========================================
    // TIER 1: CORE LOGIC & ARCHITECTURE
    // ==========================================
    {
      "name": "Control Flow & Keywords",
      "scope": "keyword.control, keyword.other, storage.type, storage.modifier",
      "font_style": "italic",
      "foreground": "var(syntax_keyword)"
    },
    {
      "name": "Logical & Comparison Operators (The Gates)",
      "scope": "keyword.operator.logical, keyword.operator.comparison, keyword.operator.relational",
      "font_style": "bold",
      "foreground": "var(syntax_operator_logic)"
    },
    {
      "name": "Math & Assignment Operators (The Mutations)",
      "scope": "keyword.operator.assignment, keyword.operator.arithmetic, keyword.operator.math, keyword.operator.increment, keyword.operator.decrement",
      "font_style": "bold",
      "foreground": "var(syntax_operator_math)"
    },
    {
      "name": "Fallback Operators",
      "scope": "keyword.operator",
      "font_style": "bold",
      "foreground": "var(syntax_operator_math)"
    },
    {
      "name": "Types and Classes",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "font_style": "italic",
      "foreground": "var(syntax_entity)"
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function, variable.function",
      "font_style": "bold",
      "foreground": "var(syntax_function)"
    },
    // ==========================================
    // TIER 2: DATA & STATE
    // ==========================================
    {
      "name": "Variable Declaration",
      "scope": "entity.name.variable, meta.definition.variable variable",
      "foreground": "var(syntax_variable)"
    },
    {
      "name": "Variable Reference",
      "scope": "variable.other, variable.parameter",
      "font_style": "italic",
      "foreground": "var(syntax_reference)"
    },
    {
      "name": "Strings",
      "scope": "(string) - (meta.mapping.key)",
      "foreground": "var(syntax_string)"
    },
    {
      "name": "Constants, Colors, and Numbers",
      "scope": "constant, support.constant.color, constant.other.color, constant.numeric",
      "font_style": "bold",
      "foreground": "var(syntax_constant)"
    },
    {
      "name": "Built-In Constants",
      "scope": "constant.language, support.constant.font-style",
      "font_style": "bold underline",
      "foreground": "var(syntax_constant)"
    },
    // ==========================================
    // TIER 3: STRUCTURAL NOISE (Background Layer)
    // ==========================================
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "var(syntax_punctuation)"
    },
    {
      "name": "Documentation (Dim)",
      "scope": "comment.block, string.quoted.docstring",
      "font_style": "italic",
      "foreground": "var(syntax_doc)"
    },
    {
      "name": "Comments (Alert/Critical)",
      "scope": "comment.line",
      "font_style": "bold",
      "foreground": "var(syntax_comment)"
    },
    // ==========================================
    // TIER 4: SPECIFIC LANGUAGE OVERRIDES
    // ==========================================
    {
      "name": "JSON/Dict Keys",
      "scope": "meta.mapping.key, (keyword.other.rule.sublime-color-scheme, keyword.other.main.sublime-color-scheme, keyword.other.variables.sublime-color-scheme)",
      "foreground": "var(syntax_mapping_keys)",
      "font_style": ""
    },
    {
      "name": "JSON/Dict Value",
      "scope": "meta.mapping.value",
      "foreground": "var(syntax_variable)"
    },
    {
      "name": "HTML/XML Tags",
      "scope": "entity.name.tag",
      "font_style": "bold",
      "foreground": "var(syntax_entity)"
    },
    {
      "name": "HTML Attributes & CSS Classes/IDs",
      "scope": "entity.other.attribute-name",
      "foreground": "var(syntax_attribute)"
    },
    {
      "name": "CSS Properties (Overrides generic support.type)",
      "scope": "support.type.property-name, meta.property-name",
      "foreground": "var(syntax_attribute)"
    },
    {
      "name": "Scope Selectors (Overrides Strings)",
      "scope": "string.unquoted.scope-segment",
      "font_style": "italic",
      "foreground": "var(syntax_selector)"
    },
    // ==========================================
    // GIT GUTTER & TELEMETRY
    // ==========================================
    {
      "name": "GitGutter: Inserted",
      "scope": "markup.inserted.git_gutter",
      "foreground": "var(git_added)"
    },
    {
      "name": "GitGutter: Changed",
      "scope": "markup.changed.git_gutter",
      "foreground": "var(git_modified)"
    },
    {
      "name": "GitGutter: Deleted",
      "scope": "markup.deleted.git_gutter",
      "foreground": "var(git_deleted)"
    },
    {
      "name": "GitGutter: Ignored",
      "scope": "markup.ignored.git_gutter",
      "foreground": "var(git_ignored)"
    },
    {
      "name": "GitGutter: Untracked",
      "scope": "markup.untracked.git_gutter",
      "foreground": "var(git_untracked)"
    },
    {
      "name": "GitGutter: Inline Annotation (Blame)",
      "scope": "comment.line.annotation.git_gutter",
      "font_style": "italic",
      "foreground": "var(git_annotation_fg)" // Maps to #6B7A99 (base_neutral_mid)
    },
    // ==========================================
    // TIER 5: SYSTEM ALERTS & FALLBACKS
    // ==========================================
    {
      "name": "Fallback",
      "scope": "source",
      "foreground": "var(status_missed)"
    },
    {
      "name": "Illegal",
      "scope": "invalid",
      "font_style": "underline bold",
      "foreground": "var(status_error)"
    }
  ]
}